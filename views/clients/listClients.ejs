<!DOCTYPE html>
<html lang="fr">
<head>
    <%- include('../parts/head') %>
</head>
<body class="clients-page">
  <%- include('../parts/header') %>

  <main>
    <div class="clients-container">

      <div class="top">
        <h1>Gestion des Clients</h1>
        <a href="/clients/create" class="btn-primary">Ajouter un client</a>
      </div>
      
      <table class="clients-table">
        <thead>
          <tr>
            <th>ID</th>
            <th>Nom</th>
            <th>Email</th>
            <th>Role</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% clients.forEach(client => { %>
            <tr>
              <td><%= client.id %></td>
              <td><%= client.name %></td>
              <td><%= client.email %></td>
              <td><%= client.role %></td>
              <td>
                <a href="/clients/<%= client.id %>" class="btn-detail">Voir</a>
                <a href="/clients/edit/<%= client.id %>" class="btn-edit">Modifier</a>
                <form action="/clients/<%= client.id %>?_method=DELETE" method="POST" style="display:inline;">
                  <button type="submit" class="btn-delete">Supprimer</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </main>

  <%- include('../parts/footer') %>

</body>
</html>
