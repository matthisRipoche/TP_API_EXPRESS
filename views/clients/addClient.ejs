<!DOCTYPE html>
<html lang="fr">
<head>
    <%- include('../parts/head') %>
</head>
<body class="clients-page">
  <%- include('../parts/header') %>

  <main>
    <div class="add-client-container">
      <div class="top">
        <h1>Ajouter un Client</h1>
      </div>
      
      <form action="/clients" method="POST" class="client-form">
        <div class="form-group">
          <label for="name">Nom *</label>
          <input type="text" id="name" name="name" required placeholder="Entrez le nom du client">
        </div>

        <div class="form-group">
          <label for="email">Email *</label>
          <input type="email" id="email" name="email" required placeholder="client@example.com">
        </div>

        <div class="form-group">
          <label for="role">Rôle *</label>
          <select id="role" name="role" required>
            <option value="">Sélectionnez un rôle</option>
            <option value="admin">Administrateur</option>
            <option value="user">Utilisateur</option>
            <option value="client">Client</option>
            <option value="moderator">Modérateur</option>
          </select>
        </div>

        <div class="form-actions">
          <button type="submit" class="btn-submit">Créer le client</button>
          <a href="/clients" class="btn-cancel">Annuler</a>
        </div>
      </form>
    </div>
  </main>

  <%- include('../parts/footer') %>
</body>
</html>